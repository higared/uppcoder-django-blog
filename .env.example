# 复制成 .env 使用（本地开发用）。不要把真的 .env 提交到 Git。
# Uppcoder 上不用这个文件，变量在平台的 Django 卡片 / 环境变量里填。

# 上线前一定要改成随机长字符串
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 本地用 SQLite 时下面两组都不用填。
# Uppcoder 会自动填 POSTGRES_*，不用手动写。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# 或者用一条连接串（二选一，不用和 POSTGRES_* 同时填）
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Uppcoder 会自动填应用自己的地址，不用手动写
# UPPCODER_SELF_URL=https://your-app.uppcoder.com
# CSRF_TRUSTED_ORIGINS=https://your-app.uppcoder.com
